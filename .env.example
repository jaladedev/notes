NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Switches on the signed /api/platform/* endpoints used by the central
# dashboard. 32+ random characters, unique per school (e.g. `openssl rand -hex 32`).
# Leave unset to keep those endpoints disabled (they answer 404).
PLATFORM_SECRET=
